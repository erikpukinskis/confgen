{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TypeScript Watch",
      "type": "shell",
      "command": "source \"$HOME/.nvm/nvm.sh\" && nvm use && yarn watch:types",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
