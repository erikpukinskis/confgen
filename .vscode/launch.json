{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug Current Test File",
      "command": "yarn vitest related \"${relativeFile}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug Current Integration Test",
      "command": "yarn vitest --config integration-tests/vitest.config.ts related \"${relativeFile}\"",
      "cwd": "${workspaceFolder}"
    }
  ]
}
