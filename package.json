{
  "name": "confgen",
  "version": "0.96.0",
  "description": "Compile Understory runtimes and presets into a project",
  "license": "MIT",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "24.22.1",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/erikpukinskis/confgen.git"
  },
  "scripts": {
    "build": "vite build && chmod +x dist/index.js",
    "build:fixtures": "cd integration-tests/fixtures/package-service && yarn build",
    "check:format": "prettier --check .",
    "check:lint": "eslint --no-error-on-unmatched-pattern .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "fix": "yarn fix:lint && yarn fix:format",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --no-error-on-unmatched-pattern . --fix",
    "install:sdks": "sdks vscode",
    "postinstall": "yarn install:sdks",
    "prepack": "yarn build",
    "test": "yarn build && vitest run",
    "test:integration": "yarn test --config integration-tests/vitest.config.ts",
    "watch:types": "tsc --noEmit --watch -p tsconfig.json "
  },
  "dependencies": {
    "commander": "^15.0.0",
    "node-diff3": "^3.2.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@yarnpkg/sdks": "2",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "3.10.1",
    "vite": "8.3.4",
    "vitest": "^4.0.7"
  }
}
