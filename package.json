{
  "name": "confgen",
  "version": "0.95.0",
  "description": "Compile Understory runtimes and presets into a project",
  "license": "MIT",
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "yarn@4.11.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/erikpukinskis/confgen.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "check:format": "prettier --check .",
    "check:lint": "eslint --no-error-on-unmatched-pattern .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "fix": "yarn fix:lint && yarn fix:format",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --no-error-on-unmatched-pattern . --fix",
    "prepack": "yarn build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
