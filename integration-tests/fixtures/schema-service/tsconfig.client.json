{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "outDir": "client/dist",
    "paths": {
      "#gql/client": ["./gql/client/index.ts"]
    }
  },
  "include": ["client/**/*.ts", "gql/client/**/*.ts"],
  "exclude": ["client/dist"]
}
