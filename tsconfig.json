{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "integration-tests/**/*.ts"
  ],
  "exclude": ["integration-tests/fixtures"]
}
